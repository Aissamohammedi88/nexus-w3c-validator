# ═══════════════════════════════════════════════════════════════════════════
# HTTP HANDLER
# ═══════════════════════════════════════════════════════════════════════════

class Handler(BaseHTTPRequestHandler):
def log_message(self, *a): pass

def _send(self, code: int, body, ctype="application/json"):
try:
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _read_json(self) -> Dict:
try:
n = int(self.headers.get("Content-Length", "0"))
if n > 10_000_000:
return {}
raw = self.rfile.read(n)
return json.loads(raw.decode("utf-8"))
except Exception:
return {}

def do_GET(self):
path = self.path.split("?")[0]
if path in ("/", "/index.html"):
return self._send(200, HTML_UI, "text/html")
if path == "/api/health":
return self._send(200, json.dumps({
"ok": True, "version": VERSION, "port": PORT,
"author": AUTEUR, "license": LICENCE,
"validators": list(CodeValidatorEngine.VALIDATORS.keys()),
}))
if path == "/api/validators":
return self._send(200, json.dumps({
"validators": {
"nu_html": "Nu HTML Checker (W3C)",
"css": "CSS Validator (W3C)",
"feed": "Feed Validator (W3C)",
"i18n": "i18n Checker (W3C)",
"rdf": "RDF Validator (W3C)",
"link": "Link Checker (W3C)",
"epub": "EPUBCheck (IDPF)",
"wpt": "Web Platform Tests",
}
}))
return self._send(404, json.dumps({"error": "not found"}))

def do_POST(self):
path = self.path.split("?")[0]
data = self._read_json()

if path == "/api/validate-all":
html = data.get("html", "")
css = data.get("css", "")
base_url = data.get("base_url", "")
if not html and not css:
return self._send(400, json.dumps({"error": "html or css required"}))
result = CodeValidatorEngine.validate_all(html, css, base_url)
return self._send(200, json.dumps(result, ensure_ascii=False, default=str))

if path == "/api/validate-html":
html = data.get("html", "")
if not html:
return self._send(400, json.dumps({"error": "html required"}))
r = NuHtmlValidator.validate(html)
return self._send(200, json.dumps(r.to_dict(), ensure_ascii=False))

if path == "/api/validate-i18n":
html = data.get("html", "")
if not html:
return self._send(400, json.dumps({"error": "html required"}))
r = I18nChecker.validate(html)
return self._send(200, json.dumps(r.to_dict(), ensure_ascii=False))

if path == "/api/validate-css":
css = data.get("css", "")
if not css:
return self._send(400, json.dumps({"error": "css required"}))
r = CSSValidator.validate(css)
return self._send(200, json.dumps(r.to_dict(), ensure_ascii=False))

if path == "/api/validate-links":
html = data.get("html", "")
base_url = data.get("base_url", "")
if not html:
return self._send(400, json.dumps({"error": "html required"}))
r = LinkChecker.validate(html, base_url)
return self._send(200, json.dumps(r.to_dict(), ensure_ascii=False))

if path == "/api/validate-rdf":
rdf = data.get("rdf", "")
fmt = data.get("format", "turtle")
if not rdf:
return self._send(400, json.dumps({"error": "rdf required"}))
r = RDFValidator.validate(rdf, fmt)
return self._send(200, json.dumps(r.to_dict(), ensure_ascii=False))

if path == "/api/validate-feed":
url = data.get("url", "")
if not url:
return self._send(400, json.dumps({"error": "url required"}))
r = FeedValidator.validate(url)
return self._send(200, json.dumps(r.to_dict(), ensure_ascii=False))

return self._send(404, json.dumps({"error": "not found"}))


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True


