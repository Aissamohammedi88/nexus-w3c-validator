class NuHtmlValidator:
"""
Nu HTML Checker — https://validator.w3.org/nu/
Valide HTML5, SVG, ARIA, HTML conformance.
"""

API = "https://validator.w3.org/nu/?out=json"

@classmethod
def validate(cls, html: str) -> ValidatorResult:
start = time.time()
result = ValidatorResult(
validator="NuHtmlChecker",
target="inline_html",
status="error",
)
try:
ok, status, body, _ = HTTP.post(
cls.API,
data=html,
headers={
"Content-Type": "text/html; charset=utf-8",
"Accept": "application/json",
},
)
if not ok:
result.status = "error"
result.issues.append(ValidationIssue(
validator=cls.__name__,
severity=Severity.ERROR.value,
message=f"API W3C indisponible : HTTP {status}",
))
result.duration_ms = (time.time() - start) * 1000
return result

data = json.loads(body)
messages = data.get("messages", [])
for m in messages:
sev = m.get("type", "info")
if sev == "error":
sev_std = Severity.ERROR.value
elif sev in ("info", "warning"):
sev_std = Severity.WARNING.value
else:
sev_std = Severity.INFO.value

result.issues.append(ValidationIssue(
validator="NuHtmlChecker",
severity=sev_std,
message=m.get("message", ""),
line=m.get("lastLine", 0),
column=m.get("lastColumn", 0),
code=m.get("subType", ""),
context=m.get("extract", "")[:200],
))

errors = sum(1 for i in result.issues if i.severity == Severity.ERROR.value)
result.status = "valid" if errors == 0 else "invalid"
result.metadata = {
"total_messages": len(messages),
"errors": errors,
"warnings": sum(1 for i in result.issues if i.severity == Severity.WARNING.value),
}
except json.JSONDecodeError:
result.status = "error"
result.issues.append(ValidationIssue(
validator=cls.__name__,
severity=Severity.ERROR.value,
message="Réponse W3C non-JSON",
))
except Exception as e:
result.status = "error"
result.issues.append(ValidationIssue(
validator=cls.__name__,
severity=Severity.ERROR.value,
message=str(e)[:200],
))
result.duration_ms = round((time.time() - start) * 1000, 2)
return result


class CSSValidator:
"""
CSS Validator — https://jigsaw.w3.org/css-validator/
Valide CSS 1, 2, 3, 4.
"""

API = "https://jigsaw.w3.org/css-validator/validator"

@classmethod
def validate(cls, css: str, profile: str = "css3") -> ValidatorResult:
start = time.time()
result = ValidatorResult(
validator="CSSValidator",
target="inline_css",
status="error",
)
try:
url = f"{cls.API}?output=json&profile={profile}&text=" + urllib.parse.quote(css)
ok, status, body, _ = HTTP.get(url)
if not ok:
result.status = "error"
result.issues.append(ValidationIssue(
validator=cls.__name__,
severity=Severity.ERROR.value,
message=f"API CSS indisponible : HTTP {status}",
))
result.duration_ms = (time.time() - start) * 1000
return result

data = json.loads(body)
css_validation = data.get("cssvalidation", {})
errors = css_validation.get("errors", [])
warnings = css_validation.get("warnings", [])

for e in errors:
result.issues.append(ValidationIssue(
validator="CSSValidator",
severity=Severity.ERROR.value,
message=e.get("message", ""),
line=e.get("line", 0),
context=e.get("context", "")[:200],
))
for w in warnings:
result.issues.append(ValidationIssue(
validator="CSSValidator",
severity=Severity.WARNING.value,
message=w.get("message", ""),
line=w.get("line", 0),
context=w.get("context", "")[:200],
))

result.status = "valid" if not errors else "invalid"
result.metadata = {
"total_errors": len(errors),
"total_warnings": len(warnings),
"profile": profile,
}
except Exception as e:
result.status = "error"
result.issues.append(ValidationIssue(
validator=cls.__name__,
severity=Severity.ERROR.value,
message=str(e)[:200],
))
result.duration_ms = round((time.time() - start) * 1000, 2)
return result


class FeedValidator:
"""
RSS/Atom Feed Validator — https://validator.w3.org/feed/
Valide RSS 2.0, Atom 1.0, RSS 1.0.
"""

API = "https://validator.w3.org/feed/check.cgi"

@classmethod
def validate(cls, url: str) -> ValidatorResult:
start = time.time()
result = ValidatorResult(
validator="FeedValidator",
target=url,
status="error",
)
try:
api_url = f"{cls.API}?url={urllib.parse.quote(url)}&output=soap12"
ok, status, body, _ = HTTP.get(api_url)
if not ok:
result.status = "error"
result.issues.append(ValidationIssue(
validator=cls.__name__,
severity=Severity.ERROR.value,
message=f"API Feed indisponible : HTTP {status}",
))
result.duration_ms = (time.time() - start) * 1000
return result

# Comptage erreurs et warnings
errors = body.count("<m:error>")
warnings = body.count("<m:warning>")
result.status = "valid" if errors == 0 else "invalid"

# Extraction simple
for m in re.finditer(r"<m:error>.*?<m:message>(.*?)</m:message>", body, re.DOTALL):
result.issues.append(ValidationIssue(
validator="FeedValidator",
severity=Severity.ERROR.value,
message=m.group(1)[:300],
))
for m in re.finditer(r"<m:warning>.*?<m:message>(.*?)</m:message>", body, re.DOTALL):
result.issues.append(ValidationIssue(
validator="FeedValidator",
severity=Severity.WARNING.value,
message=m.group(1)[:300],
))

result.metadata = {"errors": errors, "warnings": warnings}
except Exception as e:
result.status = "error"
result.issues.append(ValidationIssue(
validator=cls.__name__,
severity=Severity.ERROR.value,
message=str(e)[:200],
))
result.duration_ms = round((time.time() - start) * 1000, 2)
return result


class I18nChecker:
"""
Internationalization Checker — https://validator.w3.org/i18n-checker/
Vérifie la langue, l'encodage, la direction du texte.
"""

@classmethod
def validate(cls, html: str) -> ValidatorResult:
start = time.time()
result = ValidatorResult(
validator="I18nChecker",
target="inline_html",
status="valid",
)

# Analyse locale du HTML
checks = {
"charset": cls._check_charset(html),
"lang_attribute": cls._check_lang(html),
"dir_attribute": cls._check_dir(html),
"meta_lang": cls._check_meta_lang(html),
"content_language": cls._check_content_language(html),
"non_ascii_identifiers": cls._check_non_ascii_ids(html),
"unicode_control": cls._check_unicode_control(html),
}

for name, (status, message) in checks.items():
if status == "error":
result.issues.append(ValidationIssue(
validator="I18nChecker",
severity=Severity.ERROR.value,
message=message,
code=name,
))
result.status = "invalid"
elif status == "warning":
result.issues.append(ValidationIssue(
validator="I18nChecker",
severity=Severity.WARNING.value,
message=message,
code=name,
))

result.metadata = {
"checks": {k: v[0] for k, v in checks.items()},
"total_checks": len(checks),
}
result.duration_ms = round((time.time() - start) * 1000, 2)
return result

@staticmethod
def _check_charset(html: str) -> Tuple[str, str]:
if re.search(r'<meta[^>]+charset=["\']?utf-8', html, re.I):
return "ok", "Charset UTF-8 déclaré"
if re.search(r'<meta[^>]+charset=', html, re.I):
return "warning", "Charset déclaré mais pas UTF-8"
return "warning", "Aucun charset déclaré"

@staticmethod
def _check_lang(html: str) -> Tuple[str, str]:
if re.search(r'<html[^>]+lang=["\'][^"\']+["\']', html, re.I):
return "ok", "Attribut lang présent"
return "error", "Attribut lang manquant sur <html>"

@staticmethod
def _check_dir(html: str) -> Tuple[str, str]:
if re.search(r'<html[^>]+dir=["\'](ltr|rtl|auto)["\']', html, re.I):
return "ok", "Direction du texte déclarée"
return "warning", "Direction du texte non déclarée (défaut LTR)"

@staticmethod
def _check_meta_lang(html: str) -> Tuple[str, str]:
if re.search(r'<meta[^>]+http-equiv=["\']Content-Language["\']', html, re.I):
return "ok", "Content-Language déclaré"
return "info", "Content-Language non déclaré (facultatif)"

@staticmethod
def _check_content_language(html: str) -> Tuple[str, str]:
m = re.search(r'<meta[^>]+http-equiv=["\']Content-Language["\'][^>]+content=["\']([^"\']+)', html, re.I)
if m:
return "ok", f"Content-Language : {m.group(1)}"
return "info", "Pas de Content-Language"

@staticmethod
def _check_non_ascii_ids(html: str) -> Tuple[str, str]:
matches = re.findall(r'\b(?:id|class)=["\']([^"\']*[^\x00-\x7F][^"\']*)', html)
if matches:
return "warning", f"Identifiants non-ASCII : {matches[:3]}"
return "ok", "Identifiants ASCII uniquement"

@staticmethod
def _check_unicode_control(html: str) -> Tuple[str, str]:
# Détection de caractères de contrôle Unicode
control_chars = re.findall(r'[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]', html)
if control_chars:
return "warning", f"Caractères de contrôle trouvés : {len(control_chars)}"
return "ok", "Aucun caractère de contrôle"


class RDFValidator:
"""
RDF Validator — https://www.w3.org/RDF/Validator/
Valide RDF, Turtle, N-Triples, RDF/XML.
"""

API = "https://www.w3.org/RDF/Validator/run/"

@classmethod
def validate(cls, rdf: str, format_: str = "turtle") -> ValidatorResult:
start = time.time()
result = ValidatorResult(
validator="RDFValidator",
target="inline_rdf",
status="valid",
)
try:
url = f"{cls.API}?format={format_}"
ok, status, body, _ = HTTP.post(url, data=rdf)
if not ok:
# Fallback : validation syntaxique basique
return cls._local_validation(rdf, start)

# Extraction des messages d'erreur
errors = re.findall(r"<error>(.*?)</error>", body, re.DOTALL)
for e in errors:
result.issues.append(ValidationIssue(
validator="RDFValidator",
severity=Severity.ERROR.value,
message=e[:300],
))
result.status = "valid" if not errors else "invalid"
except Exception as e:
result.issues.append(ValidationIssue(
validator=cls.__name__,
severity=Severity.WARNING.value,
message=f"Fallback local : {str(e)[:100]}",
))
return cls._local_validation(rdf, start)

result.duration_ms = round((time.time() - start) * 1000, 2)
return result

@classmethod
def _local_validation(cls, rdf: str, start: float) -> ValidatorResult:
"""Validation syntaxique locale simple."""
result = ValidatorResult(
validator="RDFValidator(local)",
target="inline_rdf",
status="valid",
)
# Vérifications basiques
if not rdf.strip():
result.status = "invalid"
result.issues.append(ValidationIssue(
validator="RDFValidator(local)",
severity=Severity.ERROR.value,
message="RDF vide",
))
# Détection de préfixes non déclarés
prefixes = set(re.findall(r"\b([a-z]+):[A-Za-z]", rdf))
declared = set(re.findall(r"@prefix\s+([a-z]+):", rdf))
undeclared = prefixes - declared - {"http", "https"}
for p in undeclared:
result.issues.append(ValidationIssue(
validator="RDFValidator(local)",
severity=Severity.WARNING.value,
message=f"Préfixe non déclaré : {p}:",
))
result.duration_ms = round((time.time() - start) * 1000, 2)
return result


class LinkChecker:
"""
Link Checker — https://validator.w3.org/checklink
Vérifie les liens brisés dans une page.
"""

@classmethod
def validate(cls, html: str, base_url: str = "") -> ValidatorResult:
start = time.time()
result = ValidatorResult(
validator="LinkChecker",
target=base_url or "inline_html",
status="valid",
)

# Extraction des liens
links = re.findall(r'<a[^>]+href=["\']([^"\']+)', html, re.I)
links += re.findall(r'<link[^>]+href=["\']([^"\']+)', html, re.I)
links += re.findall(r'<img[^>]+src=["\']([^"\']+)', html, re.I)

# Filtre
links = list(set(l for l in links if l and not l.startswith(("#", "mailto:", "javascript:"))))

broken = []
for link in links[:50]: # limite
full_url = urljoin(base_url, link) if base_url else link
if not full_url.startswith(("http://", "https://")):
continue
try:
ok, status, _, _ = HTTP.get(full_url, timeout=5)
if not ok and status >= 400:
broken.append({"url": full_url, "status": status})
except Exception:
broken.append({"url": full_url, "status": 0})

for b in broken:
result.issues.append(ValidationIssue(
validator="LinkChecker",
severity=Severity.ERROR.value,
message=f"Lien cassé : {b['url']} (HTTP {b['status']})",
context=b["url"],
))

result.status = "valid" if not broken else "invalid"
result.metadata = {
"total_links": len(links),
"broken_links": len(broken),
"checked": min(len(links), 50),
}
result.duration_ms = round((time.time() - start) * 1000, 2)
return result


class EPUBCheck:
"""
EPUBCheck — https://validator.idpf.org/
Vérifie la conformité EPUB.
"""

@classmethod
def validate_structure(cls, files: List[str]) -> ValidatorResult:
"""Validation structurelle locale."""
start = time.time()
result = ValidatorResult(
validator="EPUBCheck",
target="epub_structure",
status="valid",
)

required = ["mimetype", "META-INF/container.xml"]
for req in required:
if req not in files:
result.issues.append(ValidationIssue(
validator="EPUBCheck",
severity=Severity.ERROR.value,
message=f"Fichier requis manquant : {req}",
))
result.status = "invalid"

result.metadata = {"total_files": len(files), "required_checked": len(required)}
result.duration_ms = round((time.time() - start) * 1000, 2)
return result


