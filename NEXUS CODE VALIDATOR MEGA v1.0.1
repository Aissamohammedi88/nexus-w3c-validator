class HttpClient:
"""Client HTTP avec SSL désactivé pour compatibilité."""

@staticmethod
def get(url: str, headers: Optional[Dict] = None,
timeout: int = 30) -> Tuple[bool, int, str, Dict]:
h = {
"User-Agent": f"NexusCodeValidator/{VERSION}",
"Accept": "*/*",
}
if headers:
h.update(headers)
try:
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
req = urllib.request.Request(url, headers=h)
with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
data = resp.read()
# Gestion gzip
if resp.headers.get("Content-Encoding") == "gzip":
data = gzip.decompress(data)
return True, resp.status, data.decode("utf-8", errors="ignore"), dict(resp.headers)
except urllib.error.HTTPError as e:
try:
body = e.read().decode("utf-8", errors="ignore")
except Exception:
body = ""
return False, e.code, body, dict(e.headers) if e.headers else {}
except Exception as e:
return False, 0, str(e)[:500], {}

@staticmethod
def post(url: str, data: str, headers: Optional[Dict] = None,
timeout: int = 30) -> Tuple[bool, int, str, Dict]:
h = {
"User-Agent": f"NexusCodeValidator/{VERSION}",
"Content-Type": "text/html; charset=utf-8",
"Accept": "*/*",
}
if headers:
h.update(headers)
try:
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
req = urllib.request.Request(url, data=data.encode("utf-8"), headers=h, method="POST")
with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
body = resp.read().decode("utf-8", errors="ignore")
return True, resp.status, body, dict(resp.headers)
except urllib.error.HTTPError as e:
try:
body = e.read().decode("utf-8", errors="ignore")
except Exception:
body = ""
return False, e.code, body, dict(e.headers) if e.headers else {}
except Exception as e:
return False, 0, str(e)[:500], {}


HTTP = HttpClient()


