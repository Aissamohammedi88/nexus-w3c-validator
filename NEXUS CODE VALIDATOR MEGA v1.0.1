class CodeValidatorEngine:
"""Moteur central de validation multi-standard."""

VALIDATORS = {
"nu_html": NuHtmlValidator,
"css": CSSValidator,
"feed": FeedValidator,
"i18n": I18nChecker,
"rdf": RDFValidator,
"link": LinkChecker,
"epub": EPUBCheck,
"wpt": WPTTester,
}

@classmethod
def validate_all(cls, html: str, css: str = "", base_url: str = "",
parallel: bool = True) -> Dict:
"""Lance tous les validateurs applicables."""
start = time.time()
results = {}
tasks = []

# HTML
tasks.append(("nu_html", lambda: NuHtmlValidator.validate(html)))
tasks.append(("i18n", lambda: I18nChecker.validate(html)))
tasks.append(("link", lambda: LinkChecker.validate(html, base_url)))

# CSS
if css:
tasks.append(("css", lambda: CSSValidator.validate(css)))

# RDF
if html.strip().startswith(("<?xml", "@prefix", "<rdf", "_:", "<http")):
tasks.append(("rdf", lambda: RDFValidator.validate(html, "rdfxml")))

if parallel and len(tasks) > 1:
with ThreadPoolExecutor(max_workers=len(tasks)) as ex:
futures = {ex.submit(fn): name for name, fn in tasks}
for fut in as_completed(futures):
name = futures[fut]
try:
results[name] = fut.result()
except Exception as e:
r = ValidatorResult(validator=name, target="", status="error")
r.issues.append(ValidationIssue(
validator=name,
severity=Severity.ERROR.value,
message=str(e)[:200],
))
results[name] = r
else:
for name, fn in tasks:
try:
results[name] = fn()
except Exception as e:
r = ValidatorResult(validator=name, target="", status="error")
r.issues.append(ValidationIssue(
validator=name,
severity=Severity.ERROR.value,
message=str(e)[:200],
))
results[name] = r

# Global
total_errors = sum(
sum(1 for i in r.issues if i.severity == Severity.ERROR.value)
for r in results.values()
)
total_warnings = sum(
sum(1 for i in r.issues if i.severity == Severity.WARNING.value)
for r in results.values()
)

return {
"target": base_url or "inline",
"validators": {k: v.to_dict() for k, v in results.items()},
"summary": {
"total_validators": len(results),
"total_errors": total_errors,
"total_warnings": total_warnings,
"overall_status": "valid" if total_errors == 0 else "invalid",
},
"duration_ms": round((time.time() - start) * 1000, 2),
}


